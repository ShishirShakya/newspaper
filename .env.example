# Optional: App State login for auto-fill when the script opens the NCLIVE login page.
# Copy this file to .env and fill in. Never commit .env.
#
# AUTOMATIC=TRUE  -> use APPSTATE_LOGIN and APPSTATE_PASSWORD to auto-fill the form.
# AUTOMATIC=FALSE -> do not auto-fill; you type your credentials in the browser.
AUTOMATIC=FALSE
APPSTATE_LOGIN=
APPSTATE_PASSWORD=
